# Multi-stage build for the public-facing web app (server/ + web/) — the
# FastAPI backend serving the built React UI, proxying chat requests to an
# already-deployed AgentCore runtime. This is a SEPARATE image from the root
# Dockerfile, which builds the AgentCore runtime container (api.py) instead;
# used by deployment/deploy-ecs-web.sh for Amazon ECS Express Mode.

FROM node:20-slim AS web-build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app

ENV UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_PROGRESS=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt requirements.txt
RUN uv pip install -r requirements.txt

COPY . .
COPY --from=web-build /app/web/dist ./web/dist
# Download CockroachDB CA certificate
RUN mkdir -p /app/certs && curl --fail --silent --show-error --create-dirs -o /app/certs/root.crt 'https://cockroachlabs.cloud/clusters/2a8a467b-46cd-49e2-b3bc-4c92678b0385/cert'
RUN useradd -m -u 1000 appuser
USER appuser

EXPOSE 8000
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
