# ============================================================================
# MemoryMesh Agent — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# ============================================================================

# --- Anthropic (reasoning) ---------------------------------------------
# Strands Agents talk to Anthropic's API directly (no Bedrock model calls).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# --- CockroachDB (persistent agent memory) ------------------------------
# CockroachDB Cloud (recommended): from the Console -> Connect -> connection string.
#   cockroachdb://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
# Local dev (cockroach demo / docker):
#   cockroachdb://root@localhost:26257/defaultdb?sslmode=disable
COCKROACHDB_URL=cockroachdb://root@localhost:26257/defaultdb?sslmode=disable
COCKROACHDB_POOL_SIZE=10
COCKROACHDB_POOL_MAX_OVERFLOW=20

# Only needed with sslmode=verify-full/verify-ca AND your cluster's cert
# isn't publicly-CA-signed (src/memory/db.py otherwise falls back to the
# OS trust store, sslrootcert=system, which is enough for most Serverless/
# Basic clusters). If connections fail with "root certificate file ...
# does not exist", set this to the UUID from the Console's own
# `curl ... 'https://cockroachlabs.cloud/clusters/<CLUSTER_ID>/cert'`
# connect snippet — the app then downloads and caches that cert itself, at
# runtime, in every deployment (local, AgentCore, ECS), no image rebuild.
# COCKROACHDB_CLUSTER_ID=

# Table names (all created/migrated automatically on startup — see scripts/init_memory_schema.py)
COCKROACHDB_CHAT_HISTORY_TABLE=message_store
COCKROACHDB_CASE_MEMORY_TABLE=case_memory

# Long-term semantic recall tuning
CASE_MEMORY_RECALL_K=3
CASE_MEMORY_SCORE_THRESHOLD=0.55

# Local embedding model used to vectorize case summaries before they're
# written to CockroachDB's VECTOR column (ONNX via fastembed, no external API).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- CockroachDB Cloud Managed MCP Server -------------------------------
# Lets the memory_ops agent introspect the memory cluster itself (read-only
# by default): case counts, schema, cluster health. Create a service account
# API key in the CockroachDB Cloud Console -> Access -> Service Accounts.
# Leave blank to disable the memory_ops agent's MCP tools gracefully.
COCKROACHDB_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACHDB_MCP_API_KEY=
# Optional: scope the MCP session to a single cluster instead of the whole org
COCKROACHDB_MCP_CLUSTER_ID=

# --- ccloud CLI (used by scripts/provision_cluster.sh, not by the running agent) ---
# CCLOUD_API_KEY=
# CCLOUD_ORG_ID=

# --- AWS (Amazon Bedrock AgentCore — hosting only, no Bedrock model calls) ---
AWS_REGION=us-east-1

# --- FastAPI layer (server/) ---
# Leave AGENTCORE_RUNTIME_ARN unset for local dev: the API runs the LangGraph
# workflow in-process instead of proxying to AgentCore. Set it (or deploy,
# which writes it into config/dynamic-config.yaml automatically) to switch
# the same server to proxy mode. AGENT_BACKEND_MODE=local|agentcore forces a
# mode instead of auto-detecting from the runtime ARN.
AGENTCORE_RUNTIME_ARN=
AGENT_BACKEND_MODE=auto
CORS_ORIGINS=*

# --- Judge access gate (server/auth.py) ------------------------------------
# Set this before deploying anywhere publicly reachable — every /api/* route
# except /api/auth/* and /api/health is blocked without it. Leave blank for
# local dev: the gate is a no-op and the app is open, same as before.
# Give judges this one password; rotating it (change + redeploy) instantly
# invalidates every existing session, since the session cookie is signed
# with a key derived from this value.
JUDGE_ACCESS_PASSWORD=
# How long a judge's login lasts before they'd need to re-enter it.
JUDGE_SESSION_TTL_HOURS=168
# Cookie requires HTTPS by default (as any real deployment should have).
# Set to false only for a plain-HTTP local test of the gate itself.
COOKIE_SECURE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_CONSOLE=false
LOG_TO_FILE=true
LOG_DIRECTORY=logs
